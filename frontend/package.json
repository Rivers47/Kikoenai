{
  "name": "kikoeru-quasar",
  "version": "1.1.1",
  "description": "A self-hosted web media player for listening to your DLsite voice works.",
  "homepage": "https://github.com/kikoeru-project/kikoeru-quasar",
  "productName": "Kikoeru",
  "cordovaId": "org.cordova.quasar.kikoeru",
  "capacitorId": "",
  "author": "Watanuki-Kimihiro",
  "contributors": [
    "yodhcn",
    "umonaca <mw2010a@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:kikoeru-project/kikoeru-quasar.git"
  },
  "license": "GPL-3.0-only",
  "keywords": [
    "kikoeru"
  ],
  "scripts": {
    "test": "node scripts/check-i18n.mjs && node scripts/check-theme-classes.mjs && node scripts/check-theme-contrast.mjs && eslint .",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:theme": "node scripts/check-theme-classes.mjs",
    "check:contrast": "node scripts/check-theme-contrast.mjs",
    "dev": "quasar dev -m pwa",
    "build": "quasar build -m pwa --debug",
    "build:prod": "quasar build -m pwa",
    "theme": "node scripts/generate-theme.mjs"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "axios": "^1.21.0",
    "plyr": "^3.8.5",
    "quasar": "^2.23.1",
    "register-service-worker": "^1.7.2",
    "socket.io-client": "^4.8.4",
    "vue": "^3.4.0",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@quasar/app-webpack": "^4.4.5",
    "@quasar/babel-preset-app": "^2.0.4",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "sass": "^1.107.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-webpack-plugin": "^7.4.1"
  },
  "engines": {
    "node": ">= 24.0.0",
    "npm": ">= 9.0.0"
  },
  "browserslist": [
    "defaults",
    "not dead",
    "iOS >= 15",
    "Safari >= 15"
  ],
  "eslintIgnore": [
    "dist/*",
    "src/router/index.js"
  ]
}
