{
  "name": "kikoeru-express",
  "version": "0.10.0",
  "description": "A self-hosted media server for listening to your DLsite voice works.",
  "homepage": "https://github.com/kikoeru-project/kikoeru-express",
  "repository": {
    "type": "git",
    "url": "git@github.com:kikoeru-project/kikoeru-express.git"
  },
  "keywords": [
    "kikoeru"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node --trace-warnings app.js",
    "dev": "nodemon --trace-warnings app.js",
    "scan": "node --trace-warnings ./filesystem/scanner.js",
    "backfill:progress": "node --trace-warnings ./scripts/backfill-progress.js",
    "lint": "eslint .",
    "test": "npm run lint && cross-env NODE_ENV=test mocha test/ --ignore test/benchmark.js",
    "bench": "cross-env NODE_ENV=test mocha test/benchmark.js"
  },
  "nodemonConfig": {
    "ignore": [
      "config/*",
      "sqlite/*"
    ],
    "delay": "2500"
  },
  "bin": "app.js",
  "pkg": {
    "scripts": [
      "filesystem/scanner.js",
      "filesystem/updater.js",
      "filesystem/workFileScanner.js",
      "database/migrations/*.js"
    ],
    "assets": [
      "dist/**/*",
      "static/**/*",
      "scraper/tag-aliases.json",
      "node_modules/sqlite3/build/node_sqlite3.node"
    ],
    "outputPath": "package"
  },
  "author": "Watanuki-Kimihiro",
  "contributors": [
    "umonaca <mw2010a@gmail.com>"
  ],
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "axios": "^1.18.1",
    "cheerio": "^1.0.0-rc.6",
    "compare-versions": "^3.6.0",
    "compression": "^1.7.4",
    "connect-history-api-fallback": "^1.6.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^8.2.0",
    "express": "^5.1.0",
    "express-validator": "^7.0.0",
    "htmlparser2": "^4.1.0",
    "jschardet": "^3.0.0",
    "knex": "^3.3.0",
    "limit-promise": "^1.0.6",
    "lodash": "^4.17.21",
    "md5": "^2.3.0",
    "natural-orderby": "^2.0.3",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "string-random": "^0.1.3",
    "tunnel-agent": "^0.6.0",
    "url-join": "^4.0.1",
    "uuid": "^11.1.1",
    "yargs": "^16.2.0",
    "mime-types": "^3.0.0"
  },
  "devDependencies": {
    "chai": "^4.3.4",
    "chai-string": "^1.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-n": "^18.2.2",
    "mocha": "^11.7.6",
    "nodemon": "^3.1.14",
    "serve-index": "^1.9.1"
  }
}
